<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!--make sure you have configSections-->
	<configSections>
		<!--each manager will fit within one section elemenet-->
		<section name="persons" type="ConfigMgrExample.ConfigManagers.PersonConfigurationManager, ConfigMgrExample" />
	</configSections>
	<startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
	<persons>
		<person name="poker" age="34" sex="MALE" is-employeed="true" />
		<person name="pokette" age="31" sex="FEMALE" is-employeed="true" />
	</persons>
</configuration>